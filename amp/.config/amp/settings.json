{
  "amp.git.commit.ampThread.enabled": false,
  "amp.git.commit.coauthor.enabled": false,
  "amp.notifications.enabled": true,
  "amp.permissions": [
    {
      "action": "ask",
      "tool": "Bash"
    },
    {
      "action": "ask",
      "tool": "create_file"
    },
    {
      "action": "ask",
      "tool": "edit_file"
    },
    {
      "action": "ask",
      "tool": "undo_edit"
    },
    {
      "action": "allow",
      "tool": "*"
    }
  ],
  "amp.tab.clipboard.enabled": false,
  "amp.tools.disable": [
    "painter"
  ]
}
