theme = Carbonfox
window-title-font-family = Inter Display
window-padding-color = extend
window-show-tab-bar = never
window-padding-x = 5
window-width = 106
window-height = 32

font-family = Berkeley Mono
font-feature = -calt
font-size = 10

adjust-underline-thickness = -50%
adjust-overline-thickness = -50%
adjust-strikethrough-thickness = -50%

cursor-style = bar
cursor-style-blink = true

shell-integration = zsh
shell-integration-features = title, cursor, ssh-terminfo

keybind = shift+enter=text:\x1b\r
keybind = control+tab=toggle_tab_overview

async-backend = io_uring
gtk-single-instance = true
scrollback-limit = 10000
clipboard-write = allow
clipboard-read = ask
